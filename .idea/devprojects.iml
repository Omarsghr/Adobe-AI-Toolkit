<?xml version="1.0" encoding="UTF-8"?>
<module external.system.id="pyproject.toml" type="PYTHON_MODULE" version="4">
  <component name="NewModuleRootManager">
    <content url="file://$MODULE_DIR$">
      <excludeFolder url="file://$MODULE_DIR$/.venv" />
      <excludeFolder url="file://$MODULE_DIR$/.vscode/Adobe-AI-Toolkit-Panel/.venv" />
      <excludeFolder url="file://$MODULE_DIR$/adobe-ai-toolkit/Adobe-AI-Toolkit-Panel/.venv" />
      <excludeFolder url="file://$MODULE_DIR$/adobe-ai-toolkit/.venv" />
    </content>
    <orderEntry type="jdk" jdkName="uv (DevProjects)" jdkType="Python SDK" />
    <orderEntry type="sourceFolder" forTests="false" />
  </component>
  <component name="PyDocumentationSettings">
    <option name="format" value="NUMPY" />
    <option name="myDocStringFormat" value="NumPy" />
  </component>
  <component name="TestRunnerService">
    <option name="PROJECT_TEST_RUNNER" value="py.test" />
  </component>
</module>